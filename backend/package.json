{
  "name": "saida-inteligente-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "prisma:seed": "tsx src/scripts/seed.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx src/scripts/e2e.ts",
    "test:config": "tsx --test tests/config.test.ts",
    "test:production": "tsx --test production-tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.44.0",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.14",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
