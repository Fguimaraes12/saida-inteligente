# Referência; Initialize-Homolog.ps1 gera .env.homolog com segredos novos.
# Senhas do banco devem ser 64 caracteres hexadecimais (URL-safe).
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_RUNTIME_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
HOMOLOG_HTTP_PORT=8080
# Inicialmente fechado; Set-HomologOrigin.ps1 atualiza as três variáveis juntas.
FRONTEND_ORIGIN=https://pending.invalid
PUBLIC_HOST=pending.invalid
PUBLIC_WS_ORIGIN=wss://pending.invalid
