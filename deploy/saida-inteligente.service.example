[Unit]
Description=Saida Inteligente API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=saida
Group=saida
WorkingDirectory=/srv/saida-inteligente/backend
EnvironmentFile=/etc/saida-inteligente/backend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/saida-inteligente/backend/dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
