# Exemplo completo para Nginx no mesmo host do backend; ajustar domínio e certificados.
worker_processes auto;
pid /var/run/nginx.pid;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format saida '$remote_addr [$time_local] $request_method $uri $status $request_time';
    access_log /var/log/nginx/saida-access.log saida;
    error_log /var/log/nginx/saida-error.log warn;
    server_tokens off;
    client_max_body_size 1m;
    limit_req_zone $binary_remote_addr zone=saida_login:10m rate=5r/m;
    limit_req_status 429;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    server {
        listen 80;
        server_name app.escola.example;
        return 308 https://app.escola.example$request_uri;
    }
    server {
        listen 443 ssl;
        server_name app.escola.example;
        ssl_certificate /etc/letsencrypt/live/app.escola.example/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/app.escola.example/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' wss://app.escola.example; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        root /srv/saida-inteligente/frontend/dist;
        index index.html;
        location = /api/auth/login {
            # Considerar NAT da escola ao ajustar a taxa, mantendo proteção contra tentativas repetidas.
            limit_req zone=saida_login burst=20 nodelay;
            proxy_pass http://127.0.0.1:3000/auth/login;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location /api/ {
            proxy_pass http://127.0.0.1:3000/;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location /socket.io/ {
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 75s;
            proxy_buffering off;
        }
        location /assets/ { try_files $uri =404; expires 1y; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
