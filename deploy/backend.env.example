# Copiar para /etc/saida-inteligente/backend.env com permissão 0600.
# Nunca usar as credenciais de desenvolvimento com dados reais.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://saida_runtime:CHANGE_ME@127.0.0.1:5432/saida_inteligente?schema=public
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h
APP_TIMEZONE=America/Sao_Paulo
FRONTEND_ORIGIN=https://app.escola.example
# SEED_DEFAULT_PASSWORD não deve existir no serviço de produção.
